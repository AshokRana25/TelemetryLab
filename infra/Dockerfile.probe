# A static HTTP probe works even in distroless backend images (no shell/wget assumption).
ARG BASE_IMAGE=otel/opentelemetry-collector-contrib:0.140.0
FROM golang:1.25.4-alpine3.22 AS probe
WORKDIR /src
COPY infra/healthcheck.go .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /healthcheck healthcheck.go
FROM ${BASE_IMAGE}
COPY --from=probe /healthcheck /healthcheck
