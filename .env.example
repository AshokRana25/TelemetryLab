# Compose deliberately opts into the local demonstration. Both apps default to false outside Compose.
DEMO_ENABLED=true
ORDER_PORT=8080
GRAFANA_PORT=3000
GRAFANA_PUBLIC_URL=http://localhost:3000
GRAFANA_ADMIN_PASSWORD=telemetrylab
# 1.5 seconds of injected delay, below the 3-second inventory request deadline.
DEMO_SLOW_SECONDS=1.5
INVENTORY_TIMEOUT_SECONDS=3.0
